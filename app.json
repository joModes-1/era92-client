{
  "expo": {
    "name": "92 CarWash",
    "slug": "carwash-loyalty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.era92.carwash",
      "infoPlist": {
        "NSCameraUsageDescription": "Workers scan a customer's QR code to start and settle a wash. The camera is only used while the scanner is open."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.era92.carwash",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Workers scan a customer's QR code to start and settle a wash. The camera is only used while the scanner is open.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#1B3C8E"
        }
      ],
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#8B3FE8"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "To show the car wash branches nearest to you and let you pick one without typing a code.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aee78ccb-7c8e-4a22-9c81-30fce3ec6e8b"
      }
    },
    "owner": "jomodes",
    "updates": {
      "url": "https://u.expo.dev/aee78ccb-7c8e-4a22-9c81-30fce3ec6e8b",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
